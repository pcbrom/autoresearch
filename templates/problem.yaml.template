# problem.yaml — canonical autoresearch problem definition.
# Replace placeholders <...> and remove irrelevant comments.

# Identification
objective: "<short description of what to minimize/maximize>"
metric_name: <metric_name>                  # e.g. val_bpb, rmse, fitness
metric_regex: '^<metric_name>:\s+([\d.eE+-]+)'  # extracted from runner stdout
lower_is_better: true                       # false to maximize

# Time budget and timeout
time_budget_s: 300                          # informational (runner enforces)
hard_timeout_s: 600                         # SIGKILL if exceeded

# Files
mutable_file: <solution.py>                 # the only file the agent edits
readonly_files:                             # contract files
  - <prepare.py>
  - <evaluate.py>
runner: "<command that runs the experiment>"

# Git
branch_prefix: <prefix>                     # e.g. autoresearch, hpsearch, tsp
results_tsv_columns:
  - commit
  - <metric_name>
  - <resource_metric>
  - status
  - description

# Optional secondary resource (VRAM, RAM, wall time)
resource_metric_regex: '^peak_vram_mb:\s+([\d.]+)'
resource_metric_transform: divide_by_1024   # MB -> GB; or: identity, divide_by_1000

# Critic (any OpenAI-compatible endpoint; Ollama-backed Gemma by default)
gemma_critic:
  enabled: true
  provider: ollama                          # ollama (local) | openrouter | openai
  model: gemma3n:e2b                         # or gemma3:27b, etc.
  when: always                              # always (coexists) | downtime (between runs)
  thinking: true                            # CoT-enriched prompt + best-effort thinking
  max_vram_gb: 8                            # ignored for remote providers
  context_last_n: 10                        # tail rows of TSV passed to the critic
  ollama_url: http://localhost:11434/v1     # base_url of the endpoint (alias: base_url)
  # api_key_env: OLLAMA_API_KEY             # env var holding the key (ollama needs none)

# --- Remote example: OpenRouter -------------------------------------------
# gemma_critic:
#   enabled: true
#   provider: openrouter
#   model: anthropic/claude-3.5-sonnet      # any OpenRouter model id
#   when: always
#   thinking: true
#   context_last_n: 10
#   base_url: https://openrouter.ai/api/v1  # default for provider=openrouter
#   api_key_env: OPENROUTER_API_KEY         # export it before running the loop

# Coder (applies next_idea.json to mutable_file each iteration)
# enabled=false (default): the loop pauses at the noop state and waits for an
# external/human agent to edit mutable_file. enabled=true: the loop invokes the
# agent below headless and advances on its own. The loop still runs the
# experiment and owns all git; the agent only edits mutable_file.
coder:
  enabled: false
  agent: claude                 # claude | codex | opencode (preset commands)
  permission: acceptEdits       # acceptEdits (edits only) | bypass (full autonomy)
  timeout_s: 300                # per-invocation hard timeout
  # command: null               # override the preset; {prompt} is substituted
  # prompt_template: null       # override the instruction; {mutable_file},
                                #   {readonly_files} are substituted

# State snapshot
state:
  enabled: true
  throttle_seconds: 300
  rebuild_every_n_iter: 5
